{
  "name": "n8n-nodes-shopxare",
  "version": "1.0.1",
  "description": "Shopxare nodes for n8n: a trigger for conversations, messages, contacts and surveys, and actions for contacts, replies and tags.",
  "keywords": [
    "n8n-community-node-package",
    "shopxare",
    "live chat",
    "customer support"
  ],
  "license": "MIT",
  "homepage": "https://shopxare.com",
  "author": {
    "name": "Shopxare"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/Shopxare/shopxare.svg dist/nodes/Shopxare/ && cp nodes/ShopxareTrigger/shopxare.svg dist/nodes/ShopxareTrigger/",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ShopxareApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Shopxare/Shopxare.node.js",
      "dist/nodes/ShopxareTrigger/ShopxareTrigger.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "^1.70.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokisoftwaretech/n8n-nodes-shopxare.git"
  },
  "bugs": {
    "url": "https://github.com/lokisoftwaretech/n8n-nodes-shopxare/issues"
  }
}
