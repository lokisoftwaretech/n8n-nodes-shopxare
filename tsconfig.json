{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": [
      "ES2021"
    ],
    "strict": true,
    "esModuleInterop": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "credentials/**/*.ts",
    "nodes/**/*.ts"
  ]
}
